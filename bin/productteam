#!/usr/bin/env bash
# productteam — interface to the Product Consulting Harness.
# Calm, inspectable, honest. All state lives in plain files under state/.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE="$ROOT/state/engagements"
# The CLI's own state (first-run marker, onboarding config). Engagements are
# unaffected; override this to run the CLI against a throwaway state root.
STATE_ROOT="${CONSULT_STATE_ROOT:-$ROOT/state/.cli}"
CONSULT_ROOT="$ROOT"
export CONSULT_ROOT

# ── theme (sole ANSI literals on the CLI surface) ────────────────────
# Structure: bold/dim/reset. Accents: success + error only (OpenCode/Droid).
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  B=$'\e[1m' D=$'\e[2m' R=$'\e[0m'
  G=$'\e[32m' RD=$'\e[31m'
  CLR=$'\e[2J\e[H'
else
  B='' D='' R='' G='' RD='' CLR=''
fi

source "$ROOT/lib/provider.sh"
source "$ROOT/lib/theme.sh"
source "$ROOT/lib/github.sh"
source "$ROOT/lib/splash.sh"
source "$ROOT/lib/onboarding.sh"
source "$ROOT/lib/activity.sh"
source "$ROOT/lib/repl.sh"
source "$ROOT/lib/render.sh"
source "$ROOT/lib/workspace.sh"
source "$ROOT/lib/judgment-gate.sh"
source "$ROOT/lib/engagement-state.sh"
source "$ROOT/lib/role-envelope.sh"

score_color() { # $1=score → accent for the score, or nothing in between
  if awk -v s="$1" 'BEGIN{exit !(s>=9)}'; then printf '%s' "$G"
  elif awk -v s="$1" 'BEGIN{exit !(s<7)}'; then printf '%s' "$RD"
  fi
  return 0
}

bar() { # $1=score (0-10) → 10-cell bar
  local n; n=$(awk -v s="$1" 'BEGIN{x=int(s+0.5); if(x>10)x=10; if(x<0)x=0; print x}')
  local out='' i
  for i in $(seq 1 10); do
    if (( i <= n )); then out+='▰'; else out+='▱'; fi
  done
  printf '%s' "$out"
}

trunc() { # $1=text $2=max → truncate with ellipsis
  local t="$1" m="${2:-72}"
  (( ${#t} > m )) && printf '%s…' "${t:0:$((m-1))}" || printf '%s' "$t"
}

spark() { # newline-separated overalls → sparkline
  local blocks='▁▂▃▄▅▆▇█' out='' i
  while read -r v; do
    [[ -z "$v" ]] && continue
    i=$(awk -v s="$v" 'BEGIN{x=int(s/10*7.99); if(x>7)x=7; if(x<0)x=0; print x}')
    out+="${blocks:i:1}"
  done
  printf '%s' "$out"
}

die() { printf '\n  %serror:%s %s\n\n' "$RD" "$R" "$1" >&2; exit 1; }
client_dir() {
  local c="$1"
  if [[ "$c" == "harness-evolution" || "$c" == "harness" ]]; then
    [[ -d "$ROOT/state/harness-evolution" ]] || die "missing state/harness-evolution"
    printf '%s' "$ROOT/state/harness-evolution"
    return
  fi
  [[ -d "$STATE/$c" ]] || die "no engagement '$c'. Known: $(ls "$STATE" 2>/dev/null | tr '\n' ' ')harness-evolution — open with: productteam open $c --repo <absolute-sibling-path>"
  printf '%s' "$STATE/$c"
}
engagement_repo() { # engagement dir → absolute Repo: path or empty
  awk -F': ' '/^Repo:/{print $2; exit}' "$1/engagement.md" 2>/dev/null || true
}
latest_run() { # client dir → highest iter-N name or empty
  { ls "$1/runs" 2>/dev/null || true; } | { grep -E '^iter-[0-9]+$' || true; } | sort -t- -k2 -n | tail -1
}
score_val() { # $1=score entry (number or {score,...}) → numeric score
  jq -r 'if type == "number" then . else .score end' <<<"$1"
}
score_ev() { # $1=score entry → evidence text (string or array joined) or empty
  jq -r 'if type == "number" then "" elif (.evidence|type) == "array" then (.evidence|join("; ")) else (.evidence // "") end' <<<"$1"
}

# ── commands ─────────────────────────────────────────────────────────
engagement_scorer() { # engagement dir → checks|provider
  local d="$1"
  if [[ -f "$d/contract.json" ]]; then
    local s
    s=$(jq -r '.scorer // empty' "$d/contract.json" 2>/dev/null || true)
    if [[ -n "$s" ]]; then printf '%s' "$s"; return; fi
  fi
  # Legacy default: ofc-v1 → checks, else provider
  local cid
  cid=$(jq -r '.contract // "v1"' "$d/contract.json" 2>/dev/null || echo v1)
  [[ "$cid" == ofc-v1 ]] && { printf 'checks'; return; }
  printf 'provider'
}

nonblank() { [[ "$1" == *[![:space:]]* ]]; }
parse_allow_dirty() {
  local reason=''
  while (( $# )); do
    case "$1" in
      --allow-dirty)
        [[ $# -ge 2 && -n "$2" ]] || die '--allow-dirty requires a non-empty reason'
        reason="$2"; shift 2 ;;
      *) die "unknown option '$1' (expected --allow-dirty <reason>)" ;;
    esac
  done
  printf '%s' "$reason"
}

parse_score_args() {
  SCORE_ITER=''
  SCORE_DIRTY_REASON=''
  while (( $# )); do
    case "$1" in
      --iter)
        [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || die '--iter requires a non-negative integer'
        SCORE_ITER="$2"; shift 2 ;;
      --allow-dirty)
        [[ $# -ge 2 && -n "$2" ]] || die '--allow-dirty requires a non-empty reason'
        SCORE_DIRTY_REASON="$2"; shift 2 ;;
      *) die "unknown score option '$1' (expected --iter <n> or --allow-dirty <reason>)" ;;
    esac
  done
  [[ -n "$SCORE_ITER" ]] || die 'scoring requires --iter <n> to bind the Analyst stamp'
}

cmd_workspace() {
  local c="$1" action="$2" d
  shift 2
  d=$(client_dir "$c")
  case "$action" in
    ensure)
      local reason snapshot
      reason=$(parse_allow_dirty "$@")
      snapshot=$(workspace_ensure "$c" "$d" "$reason") || exit $?
      printf '%s\n' "$snapshot"
      ;;
    status)
      (( $# == 0 )) || die 'usage: productteam workspace <client> status'
      workspace_snapshot "$c" "$d" ''
      ;;
    remove)
      (( $# == 0 )) || die 'usage: productteam workspace <client> remove'
      workspace_remove "$c" "$d"
      ;;
    *) die 'usage: productteam workspace <client> ensure|status|remove' ;;
  esac
}

cmd_help() {
  local prov
  prov="$(runtime_default 2>/dev/null || echo '(none)')"
  cat <<EOF

  ${B}productteam${R} — Product Consulting Harness

  ${B}Commands${R}
    productteam                     Org status and engagements overview
    productteam status              The same overview, named explicitly
    productteam chat                Interactive session (TTY; V1 robots mark)
    productteam onboarding [--yes]  First run: agents, provider, first score
    productteam splash [--frames]   Knowledge-graph banner (CONSULT_NO_SPLASH=1 skips)
    productteam agents [--json]     Coding agents on this device
    productteam runtime [--check]   Alias of agents; --check fails if none
    productteam judge <client>      Product Judgment mode + mission
    productteam judge <client> set <mode>
                                Set Guided|Directive|Challenge|Override
    productteam open <client> --repo <abs-path> [--mode …] [--scorer …]
                                Cold engagement stub + freeze stamp + workspace
    productteam baseline <client> [--allow-dirty <reason>]
                                iter-0 via workspace + checks/score entrypoints
    productteam gate <client> status|implement|select|direct|challenge|override
                                Durable judgment decisions + machine status
    productteam workspace <client> ensure|status|remove
                                Isolated client worktree lifecycle
    productteam escalation <client> block <id> <summary> <option> [option...]
    productteam escalation <client> status|resume <id> <token>
                                Durable owner block and authorized continuation
    productteam inspect <client> [out]
                                Regenerate the file-derived inspect pack
    productteam role <client> invoke <Analyst|Builder|Critic> <iter> [task]
    productteam role <client> seal <iter> <input-file>
    productteam role <client> status [iter] | close <iter>
                                Single-turn roles, sealed input, authorship gates
    productteam score <client> --iter <n>
                                Score via the declared scorer + Analyst stamp
    productteam bench <client>      Benchmark contract + history + latest scores
    productteam bench <client> run --iter <n>
                                Provider scoring with authorship gate
    productteam checks <client> [--allow-dirty <reason>]
                                Deterministic checks in isolated workspace
    productteam harness-checks [iter-dir]
                                Objective harness-apc checks + secrets scan
    productteam gh preflight [dir]  GitHub auth + permissions (tokens redacted)
    productteam gh pr-create [dir]  Push branch + open PR (CONSULT_PR_*)
    productteam gh status [dir] [n] PR view JSON
    productteam gh checks [dir] [n] PR checks
    productteam gh merge [dir] [n]  Merge only if authorize-merge present (no --admin)
    productteam gh validate [dir] [ref] [out]
                                Post-merge/PR validation artifact
    productteam skill <name> <target> [out-dir]
                                Run /critique|/benchmark|/design-sprint
    productteam run <client> <n>    Show scores for iteration n
    productteam report <client>     Latest iteration report
    productteam memory              Organizational memory
    productteam org                 Roles, loop, autonomy
    productteam smoke               CLI smoke tests
    productteam help                This text

  ${B}Non-goals${R}
    ${D}Not an IDE, not a client redesign. There is no daemon, no server and
    no database — state is plain files you can read.${R}

  ${D}State: state/engagements/<client>/ · harness-evolution: state/harness-evolution/
  Client repos: siblings (Repo: path) · Judgment: JUDGMENT.md
  Provider: ${CONSULT_PROVIDER:-$prov} · Learning: docs/learning-schema.md${R}

EOF
}

cmd_agents() {
  local check=0 json=0 a
  for a in "$@"; do
    case "$a" in
      --check) check=1 ;;
      --json)  json=1 ;;
      *) die "unknown option '$a' — usage: productteam agents [--json] [--check]" ;;
    esac
  done
  local active base
  active="${CONSULT_PROVIDER:-}"
  [[ -n "$active" ]] || active="$(runtime_default 2>/dev/null || true)"
  base=''
  [[ -n "$active" ]] && base="$(basename "$active")"

  if (( json )); then
    runtime_detect | jq -R -s 'split("\n") | map(select(length > 0)) | map(split("\t"))
      | map({name: .[0], status: .[1], path: .[2], version: .[3], note: .[4]})'
    return 0
  fi

  printf '\n  %sCoding agents%s\n' "$B" "$R"
  local name status path ver note
  while IFS=$'\t' read -r name status path ver note; do
    if [[ "$status" == found ]]; then
      if [[ "$name" == "$active" || "$name" == "$base" ]]; then
        printf '  %s●%s %-9s %-14s %s%s%s %s(selected)%s\n' "$G" "$R" "$name" "$ver" "$D" "$path" "$R" "$B" "$R"
      else
        printf '  %s●%s %-9s %-14s %s%s%s\n' "$G" "$R" "$name" "$ver" "$D" "$path" "$R"
      fi
    else
      printf '  %s○%s %-9s %s%s%s\n' "$D" "$R" "$name" "$D" "missing · $note" "$R"
    fi
  done < <(runtime_detect)
  printf '\n  %sActive provider: %s%s\n' "$D" "${active:-none · set CONSULT_PROVIDER}" "$R"
  printf '  %sCatalog: %s entries · search order PATH then CONSULT_AGENT_DIRS · seam: lib/provider.sh%s\n\n' \
    "$D" "${#AGENT_CATALOG[@]}" "$R"

  if (( check )); then
    if [[ -z "$active" ]] || ! runtime_have "$active"; then
      die "provider ${active:-unset} is not a usable executable. Install one of the agents above, or set CONSULT_PROVIDER=<binary>."
    fi
  fi
}

cmd_splash() {
  splash_show "$@" || die 'usage: productteam splash [--frames|--no-splash]'
}

cmd_onboarding() {
  local apply=0 a
  [[ "${CONSULT_NONINTERACTIVE:-}" == 1 ]] && apply=1
  for a in "$@"; do
    case "$a" in
      --yes|--non-interactive) apply=1 ;;
      *) die "unknown option '$a' — usage: productteam onboarding [--yes]" ;;
    esac
  done
  onboarding_run "$apply"
}

# First run only: show the banner once, then leave a marker so it never replays.
first_run_notice() {
  local marker="$STATE_ROOT/first-run"
  [[ -e "$marker" ]] && return 0
  mkdir -p "$STATE_ROOT" 2>/dev/null || return 0
  printf 'seen\n' > "$marker" 2>/dev/null || return 0
  [[ -n "${CONSULT_NO_SPLASH:-}" ]] && return 0
  splash_banner "$SPLASH_FRAME_COUNT"
}

cmd_harness_checks() {
  local iter="${1:-}"
  local checker="$ROOT/lib/harness-checks.sh"
  [[ -f "$checker" ]] || die "missing $checker"
  if [[ -n "$iter" ]]; then
    mkdir -p "$iter"
    bash "$checker" "$iter"
  else
    bash "$checker"
  fi
}

cmd_status() {
  first_run_notice
  local prov
  prov="$(runtime_default 2>/dev/null || echo none)"
  cat <<EOF

  ${B}Product Consulting Harness${R}
  ${D}Product Judgment Layer · CLI-first · evidence over opinion${R}
  ${D}Provider: ${CONSULT_PROVIDER:-$prov} · agents: productteam agents${R}

EOF
  local found=0
  for d in "$STATE"/*/; do
    [[ -d "$d" ]] || continue
    found=1
    local name; name=$(basename "$d")
    local last; last=$(latest_run "$d")
    local desc=''
    [[ -f "$d/engagement.md" ]] && desc=$(awk -F': ' '/^Vision:/{print $2; exit}' "$d/engagement.md")
    if [[ -n "$last" && -f "$d/runs/$last/scores.json" ]]; then
      local ov prev ov_prev trend
      ov=$(jq -r '.overall' "$d/runs/$last/scores.json")
      prev=$(ls "$d/runs" 2>/dev/null | grep -E '^iter-[0-9]+$' | sort -t- -k2 -n | awk -v l="$last" '$0!=l' | tail -1)
      if [[ -n "$prev" && -f "$d/runs/$prev/scores.json" ]]; then
        ov_prev=$(jq -r '.overall' "$d/runs/$prev/scores.json")
        trend=$(awk -v a="$ov" -v b="$ov_prev" 'BEGIN{d=a-b; printf "%s%.1f", (d>=0?"+":""), d}')
      else
        trend='baseline'
      fi
      local at
      at=$(jq -r '[.scores | to_entries[] | select(.value.score>=9)] | length' "$d/runs/$last/scores.json")
      printf '  %s●%s %s%s%s %s%s%s %s\n' \
        "$B" "$R" "$B" "$(trunc "$name" 18)" "$R" "$(score_color "$ov")" "$(trunc "$ov" 4)" "$R" "$(trunc "$trend · $at/9≥9" 28)"
      printf '    %s%s%s\n' "$D" "$(trunc "${desc:-no brief} · $last" 90)" "$R"
    else
      printf '  %s○%s %s%s%s %snot scored%s\n' "$D" "$R" "$B" "$(trunc "$name" 18)" "$R" "$D" "$R"
      printf '    %s%s%s\n' "$D" "$(trunc "${desc:-no brief}" 90)" "$R"
    fi
  done
  (( found )) || printf '  %sNo engagements yet. Create state/engagements/<client>/engagement.md.%s\n' "$D" "$R"
  printf '\n  %sbench <client> for scores · report <client> for reasoning · help for all%s\n\n' "$D" "$R"
}

cmd_org() {
  cat <<EOF

  ${B}The organization${R} ${D}(AGENTS.md · CONSTITUTION.md · JUDGMENT.md)${R}

    $(role_chrome Principal)   orchestrates the loop; decides, escalates; never self-scores
    $(role_chrome Analyst)     inspects and scores against the frozen contract, with evidence
    $(role_chrome Builder)     implements accepted items; smallest diff; verification attached
    $(role_chrome Critic)      rebuts priorities, audits diffs and scores, reviews the org

  ${B}Product Judgment modes${R}
    Guided · Directive · Challenge · Override   ${D}(see JUDGMENT.md)${R}

  ${B}Temporary specialists${R} ${D}(spawned per engagement, then disbanded)${R}
    Repository Analyst · Benchmark Designer · Test Engineer ·
    Product Specialists · Implementation Agent · Independent Verifier ·
    Harness Critic

  ${B}Loop${R}
    Inspect → Measure baseline → Prioritize → Implement → Test →
    Re-benchmark → Independently verify → Critique → Memory →
    Safe harness improvements → Repeat

  ${B}Autonomy${R}
    Auto-apply: low-risk, reversible, evidence-backed.
    Escalate:   permanent workers · architecture · security/auth ·
                autonomy policy · destructive acts · scope changes.

  ${D}Permanent workers beyond the four require evidence + owner approval.${R}

EOF
}

cmd_judge() {
  local c="$1" d; d=$(client_dir "$c")
  [[ -f "$d/engagement.md" ]] || die "missing $d/engagement.md"
  local mode
  mode=$(awk '/^Mode:/{gsub(/\*/,""); print $2; exit}' "$d/engagement.md")
  mode="${mode:-Guided}"
  printf '\n  %sProduct Judgment — %s%s\n' "$B" "$c" "$R"
  printf '  Mode: %s%s%s   %s(Guided|Directive|Challenge|Override)%s\n\n' "$B" "$mode" "$R" "$D" "$R"
  if [[ -f "$d/engagement.md" ]]; then
    awk '
      /^## Mission/{flag=1; print "  "$0; next}
      /^## / && flag{exit}
      flag{print "  "$0}
    ' "$d/engagement.md"
  fi
  printf '\n  %sFull modes: JUDGMENT.md · set: productteam judge %s set <mode>%s\n\n' "$D" "$c" "$R"
}

cmd_judge_set() {
  local c="$1" mode="$2" d; d=$(client_dir "$c")
  case "$mode" in
    Guided|Directive|Challenge|Override) ;;
    guided) mode=Guided ;;
    directive) mode=Directive ;;
    challenge) mode=Challenge ;;
    override) mode=Override ;;
    *) die "mode must be Guided|Directive|Challenge|Override" ;;
  esac
  [[ -f "$d/engagement.md" ]] || die "missing $d/engagement.md"
  if grep -q '^Mode:' "$d/engagement.md"; then
    sed -i "s/^Mode:.*/Mode: **${mode}** (Product Judgment Layer)/" "$d/engagement.md"
  else
    sed -i "1a Mode: **${mode}** (Product Judgment Layer)" "$d/engagement.md"
  fi
  printf '\n  %sMode set to %s%s for %s\n\n' "$G" "$mode" "$R" "$c"
}

cmd_gate() {
  local c="$1" action="$2" d; shift 2
  d=$(client_dir "$c"); [[ -f "$d/engagement.md" ]] || die "missing $d/engagement.md"
  local mode; mode=$(judgment_mode "$d")
  case "$action" in
    status) (($# == 0)) || die 'usage: productteam gate <client> status'; judgment_status "$c" "$d" ;;
    implement)
      (($# <= 1)) || die 'usage: productteam gate <client> implement [direction]'
      local want="${1:-}" refusal block_reason
      block_reason=$(progress_blocked_reason "$d"); [[ -z "$block_reason" ]] || die "$block_reason"
      [[ -n "$want" ]] || want=$(judgment_bound_direction "$d" "$mode")
      refusal=$(judgment_implement_refusal "$d" "$mode" "$want"); [[ -z "$refusal" ]] || die "$refusal"
      printf '\n  %sGate: %s implement allowed%s\n\n' "$G" "$c" "$R" ;;
    select) (($# == 1 || $# == 2)) || die 'usage: productteam gate <client> select <direction> [selected-by]'; [[ "$mode" == Guided || "$mode" == Challenge ]] || die "mode is $mode — select requires Guided or Challenge"; judgment_write_selection "$d" "$1" "${2:-principal}" >/dev/null ;;
    direct)
      (($# >= 1)) || die 'usage: productteam gate <client> direct <direction> [risk...]'
      [[ "$mode" == Directive ]] || die "mode is $mode — direct requires Directive"
      nonblank "$1" || die 'directive direction must be non-blank'
      judgment_write_directive "$d" "$1" "${@:2}" >/dev/null ;;
    override)
      (($# == 4)) || die 'usage: productteam gate <client> override <direction> <risk> <critic-record> <evidence-record>'
      nonblank "$1" && nonblank "$2" && nonblank "$3" && nonblank "$4" || die 'override direction, risk, critic record, and evidence record must be non-empty'
      [[ "$mode" == Override ]] || die "mode is $mode — override requires Override"
      judgment_write_override "$d" "$1" "$2" "$3" "$4" >/dev/null ;;
    challenge) (($# == 3)) || die 'usage: productteam gate <client> challenge <harmful> <safer> <evidence>'; [[ "$mode" == Challenge ]] || die "mode is $mode — challenge requires Challenge"; judgment_write_challenge "$d" "$1" "$2" "$3" >/dev/null ;;
    *) die 'usage: productteam gate <client> status|implement|select|direct|challenge|override …' ;;
  esac
}

cmd_escalation() {
  local c="$1" action="$2" d; shift 2; d=$(client_dir "$c")
  case "$action" in
    block) (($# >= 3)) || die 'usage: productteam escalation <client> block <id> <summary> <option> [option...]'; escalation_block "$c" "$d" "$1" "$2" "${@:3}" ;;
    status) (($# == 0)) || die 'usage: productteam escalation <client> status'; escalation_status "$c" "$d" ;;
    resume) (($# == 2)) || die 'usage: productteam escalation <client> resume <id> <token>'; escalation_resume "$c" "$d" "$1" "$2" ;;
    *) die 'usage: productteam escalation <client> block|status|resume …' ;;
  esac
}

cmd_inspect() {
  local c="$1" out="${2:-}" d; d=$(client_dir "$c"); [[ -n "$out" ]] || out="$d/inspect-pack.json"
  inspect_write_pack "$c" "$d" "$out" >/dev/null
  printf '\n  %sInspect pack regenerated:%s %s\n\n' "$B" "$R" "$out"
}

cmd_role() {
  local c="$1" action="$2" d; shift 2; d=$(client_dir "$c")
  case "$action" in
    seal) (($# == 2)) || die 'usage: productteam role <client> seal <iter> <input-file>'; local seal; seal=$(role_seal "$d" "$1" "$2" "${CONSULT_ROLE_IDENTITY:-principal}") || die "$seal"; printf '\n  %sBuilder input sealed:%s %s\n\n' "$B" "$R" "$seal" ;;
    invoke)
      (($# >= 2)) || die 'usage: productteam role <client> invoke <Analyst|Builder|Critic> <iter> [task]'
      local role="$1" iter="$2" task=''; shift 2; role=$(role_name "$role") || die 'role must be Analyst, Builder, or Critic'
      if [[ "$role" == Builder ]]; then (($# == 0)) || die 'Builder task is the sealed input'; else (($# == 1)) || die "usage: productteam role <client> invoke $role <iter> <task>"; task="$1"; fi
      role_invoke "$c" "$d" "$role" "$iter" "$task" ;;
    status) (($# <= 1)) || die 'usage: productteam role <client> status [iter]'; role_status "$c" "$d" "${1:-}" ;;
    close) (($# == 1)) || die 'usage: productteam role <client> close <iter>'; local close; close=$(role_close "$d" "$1") || die "$close"; printf '\n  %sIteration closed:%s %s\n\n' "$B" "$R" "$close" ;;
    *) die 'usage: productteam role <client> seal|invoke|status|close …' ;;
  esac
}

# An engagement whose subject is this repo cannot be checked from inside this
# CLI: its suite drives `productteam checks <client>` itself, so calling the suite
# here would recurse. Route to it by name and show the last recorded run.
checks_self_route() { # $1=client $2=engagement dir $3=runner (repo-relative)
  local c="$1" d="$2" rel="$3" last j
  printf '  %sThis suite scores this CLI and drives `productteam checks %s` itself,%s\n' "$D" "$c" "$R"
  printf '  %sso running it from here would recurse. Run the suite directly:%s\n\n' "$D" "$R"
  printf '    bash %s state/engagements/%s/runs/iter-N\n\n' "$rel" "$c"
  last=$(latest_run "$d")
  j="$d/runs/$last/checks.json"
  if [[ -n "$last" && -f "$j" ]]; then
    printf '  %slast recorded %s: %s passed · %s failed · %s skipped · overall %s (%s)%s\n\n' \
      "$D" "$last" "$(jq -r '.passed' "$j")" "$(jq -r '.failed' "$j")" \
      "$(jq -r '.skipped' "$j")" "$(jq -r '.overall' "$j")" "$(jq -r '.kind' "$j")" "$R"
  else
    printf '  %sno recorded run yet under state/engagements/%s/runs/%s\n\n' "$D" "$c" "$R"
  fi
}

cmd_checks() {
  local c="$1"; shift
  local d; d=$(client_dir "$c")
  local block_reason; block_reason=$(progress_blocked_reason "$d")
  [[ -z "$block_reason" ]] || die "$block_reason"
  local scorer; scorer=$(engagement_scorer "$d")
  [[ "$scorer" == checks ]] || die "engagement '$c' uses scorer=$scorer — use: productteam score $c (or productteam bench $c run)"
  local dirty_reason='' cid rel source_repo snapshot repo check_dir
  dirty_reason=$(parse_allow_dirty "$@")
  cid=$(jq -r '.contract // "unknown"' "$d/contract.json" 2>/dev/null || echo unknown)
  rel=$(jq -r '.checks_runner // empty' "$d/contract.json" 2>/dev/null || true)
  source_repo=$(engagement_repo "$d")
  printf '\n  %sDeterministic checks — %s%s\n' "$B" "$c" "$R"

  # The engagement picks its own runner; without one, the shared client suite.
  if [[ -n "$rel" ]]; then
    [[ -f "$ROOT/$rel" ]] || die "contract $cid names checks_runner '$rel', which is missing under $ROOT — fix .checks_runner in $d/contract.json"
    printf '  %scontract %s · runner %s%s\n\n' "$D" "$cid" "$rel" "$R"
    if [[ "$source_repo" == "$ROOT" ]]; then
      checks_self_route "$c" "$d" "$rel"
      return 0
    fi
    # Named engagement runners still operate through the isolated worktree.
    snapshot=$(workspace_ensure "$c" "$d" "$dirty_reason") || exit $?
    repo=$(jq -r '.path' <<<"$snapshot")
    check_dir="$d/runs/check-$(date -u +%Y%m%dT%H%M%SZ)-$$"
    mkdir -p "$check_dir"
    workspace_write_evidence "$snapshot" "$check_dir/workspace.json" checks
    local pre_dirty=''
    pre_dirty=$(git -C "$repo" status --porcelain --untracked-files=all 2>/dev/null || true)
    # Runner contract: <check-dir> [workspace-path]. Self-scoring harness
    # suites may ignore the workspace argument; client suites must use it.
    bash "$ROOT/$rel" "$check_dir" "$repo"
    if [[ -z "$pre_dirty" ]]; then
      git -C "$repo" checkout -- . >/dev/null 2>&1 || true
      git -C "$repo" clean -fd >/dev/null 2>&1 || true
    fi
    snapshot=$(workspace_snapshot "$c" "$d" "$dirty_reason")
    workspace_write_evidence "$snapshot" "$check_dir/workspace.json" checks
    CHECKS_LAST_DIR="$check_dir"
    CHECKS_LAST_SNAPSHOT="$snapshot"
    return
  fi
  [[ -n "$source_repo" && -d "$source_repo" ]] || die "client repo not found: ${source_repo:-no Repo: line} — set an absolute Repo: path in $d/engagement.md"
  snapshot=$(workspace_ensure "$c" "$d" "$dirty_reason") || exit $?
  repo=$(jq -r '.path' <<<"$snapshot")
  check_dir="$d/runs/check-$(date -u +%Y%m%dT%H%M%SZ)-$$"
  mkdir -p "$check_dir"
  workspace_write_evidence "$snapshot" "$check_dir/workspace.json" checks
  local checker="$ROOT/lib/run-checks.sh"
  [[ -f "$checker" ]] || die "missing $checker — restore it or set .checks_runner in $d/contract.json"
  printf '  %scontract %s · workspace %s · runner lib/run-checks.sh%s\n\n' "$D" "$cid" "$repo" "$R"
  local pre_dirty=''
  pre_dirty=$(git -C "$repo" status --porcelain --untracked-files=all 2>/dev/null || true)
  bash "$checker" "$c" "$d" "$repo"
  # Checks may rewrite tracked build caches (e.g. tsconfig.tsbuildinfo). If the
  # workspace was clean on entry, restore that cleanliness so subsequent role
  # invokes are not blocked by measurement side-effects.
  if [[ -z "$pre_dirty" ]]; then
    git -C "$repo" checkout -- . >/dev/null 2>&1 || true
    git -C "$repo" clean -fd >/dev/null 2>&1 || true
  fi
  # Refresh snapshot SHA/dirty after any restore so archived evidence matches.
  snapshot=$(workspace_snapshot "$c" "$d" "$dirty_reason")
  workspace_write_evidence "$snapshot" "$check_dir/workspace.json" checks
  # Keep a pointer beside the unique check archive so later sessions can find evidence.
  if [[ -f "$d/runs/.checks-latest.json" ]]; then
    cp -f "$d/runs/.checks-latest.json" "$check_dir/checks.json"
  fi
  CHECKS_LAST_DIR="$check_dir"
  CHECKS_LAST_SNAPSHOT="$snapshot"
}

cmd_score_checks_publish() {
  # Bind Analyst-stamped deterministic scores into runs/iter-N (ofc-v1 path).
  local c="$1" d="$2" n="$3" dirty_reason="$4"
  local rd="$d/runs/iter-$n" latest stamp evaluator snapshot
  [[ -e "$rd/scores.json" ]] && die "scores already exist for role iter $n: $rd/scores.json"
  latest="$d/runs/.checks-latest.json"
  [[ -f "$latest" ]] || die "missing $latest after checks — cannot publish iter $n scores"
  stamp=$(role_stamp_path "$d" "$n")
  evaluator=$(jq -r '.identity' "$stamp")
  mkdir -p "$rd"
  if [[ -n "${CHECKS_LAST_SNAPSHOT:-}" ]]; then
    snapshot="$CHECKS_LAST_SNAPSHOT"
  else
    snapshot=$(workspace_ensure "$c" "$d" "$dirty_reason") || exit $?
  fi
  workspace_write_evidence "$snapshot" "$rd/workspace.json" score
  jq --argjson iter "$n" --arg evaluator "$evaluator" --arg stamp "$stamp" \
    --arg check_dir "${CHECKS_LAST_DIR:-}" \
    '. + {iter:$iter, kind:(if $iter == 0 then "baseline" else "iteration" end), evaluator:$evaluator, analyst_stamp:$stamp, check_evidence:(if $check_dir == "" then null else $check_dir end)}' \
    "$latest" > "$rd/scores.json"
  if [[ -n "${CHECKS_LAST_DIR:-}" && -f "$CHECKS_LAST_DIR/checks.json" ]]; then
    cp -f "$CHECKS_LAST_DIR/checks.json" "$rd/checks.json"
  elif [[ -f "$latest" ]]; then
    cp -f "$latest" "$rd/checks.json"
  fi
  jq -c '{ts, iter, kind, evaluator, analyst_stamp, overall, scores}' "$rd/scores.json" >> "$d/history.jsonl"
  local ov; ov=$(jq -r '.overall' "$rd/scores.json")
  printf '  %sRecorded iter %s — overall %s%s\n' "$B" "$n" "$(score_color "$ov")" "$ov"
  printf '  %sAnalyst stamp:%s %s\n\n' "$D" "$R" "$stamp"
}

cmd_score() {
  local c="$1"; shift
  local d; d=$(client_dir "$c")
  parse_score_args "$@"
  local refusal; refusal=$(role_stamp_refusal "$d" "$SCORE_ITER")
  [[ -z "$refusal" ]] || die "$refusal"
  local scorer; scorer=$(engagement_scorer "$d")
  case "$scorer" in
    checks)
      CHECKS_LAST_DIR=''
      CHECKS_LAST_SNAPSHOT=''
      if [[ -n "$SCORE_DIRTY_REASON" ]]; then
        cmd_checks "$c" --allow-dirty "$SCORE_DIRTY_REASON"
      else
        cmd_checks "$c"
      fi
      cmd_score_checks_publish "$c" "$d" "$SCORE_ITER" "$SCORE_DIRTY_REASON"
      ;;
    provider)
      if [[ -n "$SCORE_DIRTY_REASON" ]]; then
        cmd_bench_run "$c" --iter "$SCORE_ITER" --allow-dirty "$SCORE_DIRTY_REASON"
      else
        cmd_bench_run "$c" --iter "$SCORE_ITER"
      fi
      ;;
    *) die "unknown scorer '$scorer' in $d/contract.json (expected checks|provider)" ;;
  esac
}

cmd_skill() {
  local skill="${1:-}" target="${2:-}" out="${3:-}"
  [[ -n "$skill" && -n "$target" ]] || die 'usage: productteam skill <critique|benchmark|design-sprint> <repo-or-client> [out-dir]'
  local runner="$ROOT/lib/run-skill.sh"
  [[ -f "$runner" ]] || die "missing $runner"
  bash "$runner" "$skill" "$target" "$out"
}

cmd_open() {
  # Cold engagement bootstrap: stub + freeze stamp from a sibling Repo:.
  local c='' repo='' mode='Guided' scorer='provider' contract='' mission='' public=''
  while (( $# )); do
    case "$1" in
      --repo)
        [[ $# -ge 2 && -n "$2" ]] || die 'usage: productteam open <client> --repo <absolute-path> [--mode …] [--scorer …] [--contract …]'
        repo="$2"; shift 2 ;;
      --mode)
        [[ $# -ge 2 && -n "$2" ]] || die '--mode requires Guided|Directive|Challenge|Override'
        mode="$2"; shift 2 ;;
      --scorer)
        [[ $# -ge 2 && -n "$2" ]] || die '--scorer requires checks|provider'
        scorer="$2"; shift 2 ;;
      --contract)
        [[ $# -ge 2 && -n "$2" ]] || die '--contract requires an id'
        contract="$2"; shift 2 ;;
      --mission)
        [[ $# -ge 2 && -n "$2" ]] || die '--mission requires text'
        mission="$2"; shift 2 ;;
      --public)
        [[ $# -ge 2 && -n "$2" ]] || die '--public requires a URL'
        public="$2"; shift 2 ;;
      -*)
        die "unknown open option '$1'" ;;
      *)
        if [[ -z "$c" ]]; then c="$1"; shift; else die "unexpected argument '$1'"; fi ;;
    esac
  done
  [[ -n "$c" && -n "$repo" ]] || die 'usage: productteam open <client> --repo <absolute-path> [--mode Guided|Directive|Challenge|Override] [--scorer checks|provider] [--contract <id>] [--mission <text>] [--public <url>]'
  [[ "$c" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || die "open-invalid-client: '$c' (use lowercase slug [a-z0-9_-]+)"
  case "$mode" in Guided|Directive|Challenge|Override) ;; *) die "open-invalid-mode: $mode" ;; esac
  case "$scorer" in checks|provider) ;; *) die "open-invalid-scorer: $scorer" ;; esac
  [[ -d "$STATE/$c" ]] && die "open-exists: $c (engagement already at $STATE/$c)"
  [[ "$repo" == /* ]] || die "open-repo-not-absolute: $repo"
  [[ -d "$repo" ]] || die "open-repo-missing: $repo"
  git -C "$repo" rev-parse --show-toplevel >/dev/null 2>&1 || die "open-repo-not-git: $repo"
  repo=$(git -C "$repo" rev-parse --show-toplevel)
  [[ -n "$contract" ]] || contract="${c}-v1"
  [[ -n "$mission" ]] || mission="Improve ${c} against frozen contract ${contract}. Measure baseline before changes."
  local frozen d
  frozen=$(date -u +%Y-%m-%d)
  d="$STATE/$c"
  mkdir -p "$d/runs" "$d/judgment"
  cat > "$d/engagement.md" <<EOF
# Engagement: $c

Opened: $frozen · Contract: $contract (frozen) · Client owner: local
Mode: **$mode**

Repo: $repo
Public: ${public:-}
Scorer: $scorer
Vision: Sibling product engagement opened via productteam open.

## Mission

$mission
EOF
  if [[ "$scorer" == checks ]]; then
    jq -n --arg contract "$contract" --arg frozen "$frozen" --arg client "$c" \
      '{contract:$contract,frozen:$frozen,scorer:"checks",client:$client,target:9.0,convergence:"every dimension >= 9.0",max_iterations:5,source:"BENCHMARK-CONTRACT.md",dimensions:["correctness","simplicity","maintainability","usability","developer-experience","documentation","product-clarity","architecture"],baseline_rules:{iter_0:"Before any engagement change.",immutable:"Never re-scored retroactively."}}' \
      > "$d/contract.json"
  else
    jq -n --arg contract "$contract" --arg frozen "$frozen" --arg client "$c" \
      '{contract:$contract,frozen:$frozen,scorer:"provider",client:$client,target:9.0,convergence:"every dimension >= 9.0",max_iterations:5,source:"BENCHMARK-CONTRACT.md",dimensions:["correctness","simplicity","maintainability","usability","educational-quality","developer-experience","architecture","documentation","product-clarity"],baseline_rules:{iter_0:"Before any engagement change.",immutable:"Never re-scored retroactively."}}' \
      > "$d/contract.json"
  fi
  cat > "$d/BENCHMARK-CONTRACT.md" <<EOF
# Frozen benchmark — $contract

Frozen: $frozen via \`productteam open\`. Do not move goalposts mid-engagement.

## Mission

$mission

## Scorer

\`$scorer\` (declared in contract.json). Baseline is \`productteam baseline $c\`.
EOF
  jq -n --arg client "$c" --arg repo "$repo" --arg contract "$contract" --arg frozen "$frozen" \
    --arg mode "$mode" --arg scorer "$scorer" --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{client:$client,repo:$repo,contract:$contract,frozen:$frozen,mode:$mode,scorer:$scorer,opened_at:$ts,tool:"productteam open"}' \
    > "$d/open-stamp.json"
  local snapshot
  snapshot=$(workspace_ensure "$c" "$d" '') || exit $?
  printf '\n  %sOpened engagement %s%s\n' "$B" "$c" "$R"
  printf '  %srepo%s %s\n' "$D" "$R" "$repo"
  printf '  %scontract%s %s (frozen %s) · scorer %s · mode %s\n' "$D" "$R" "$contract" "$frozen" "$scorer" "$mode"
  printf '  %sworkspace%s %s\n' "$D" "$R" "$(jq -r .path <<<"$snapshot")"
  printf '  %snext%s productteam baseline %s\n\n' "$D" "$R" "$c"
}

cmd_baseline() {
  # iter-0 measurement through workspace + checks/score entrypoints.
  local c="${1:-}"; shift || true
  [[ -n "$c" ]] || die 'usage: productteam baseline <client> [--allow-dirty <reason>]'
  local dirty_reason='' d rd
  dirty_reason=$(parse_allow_dirty "$@")
  d=$(client_dir "$c")
  [[ -f "$d/engagement.md" ]] || die "baseline-missing-engagement: $d/engagement.md"
  [[ -f "$d/contract.json" ]] || die "baseline-missing-contract: $d/contract.json"
  rd="$d/runs/iter-0"
  [[ -e "$rd/scores.json" ]] && die "baseline-exists: $rd/scores.json"
  local block_reason; block_reason=$(progress_blocked_reason "$d")
  [[ -z "$block_reason" ]] || die "$block_reason"
  local snapshot repo scorer runner cid
  snapshot=$(workspace_ensure "$c" "$d" "$dirty_reason") || exit $?
  repo=$(jq -r '.path' <<<"$snapshot")
  scorer=$(engagement_scorer "$d")
  cid=$(jq -r '.contract // "unknown"' "$d/contract.json")
  runner=$(jq -r '.checks_runner // empty' "$d/contract.json" 2>/dev/null || true)
  mkdir -p "$rd"
  workspace_write_evidence "$snapshot" "$rd/workspace.json" baseline
  printf '\n  %sBaseline iter-0 — %s%s\n' "$B" "$c" "$R"
  printf '  %scontract %s · scorer %s · workspace %s%s\n\n' "$D" "$cid" "$scorer" "$repo" "$R"

  if [[ "$scorer" == checks ]]; then
    if [[ -n "$runner" ]]; then
      [[ -f "$ROOT/$runner" ]] || die "baseline-runner-missing: contract names checks_runner '$runner'"
      CHECKS_LAST_DIR=''
      CHECKS_LAST_SNAPSHOT="$snapshot"
      if [[ -n "$dirty_reason" ]]; then
        cmd_checks "$c" --allow-dirty "$dirty_reason"
      else
        cmd_checks "$c"
      fi
      # Publish without Analyst stamp — cold baseline bootstrap path.
      local latest="$d/runs/.checks-latest.json"
      [[ -f "$latest" ]] || die "baseline-checks-failed: missing $latest"
      jq --argjson iter 0 --arg evaluator baseline-bootstrap \
        --arg check_dir "${CHECKS_LAST_DIR:-}" \
        '. + {iter:0, kind:"baseline", evaluator:$evaluator, analyst_stamp:null, check_evidence:(if $check_dir=="" then null else $check_dir end)}' \
        "$latest" > "$rd/scores.json"
      [[ -n "${CHECKS_LAST_DIR:-}" && -f "$CHECKS_LAST_DIR/checks.json" ]] && cp -f "$CHECKS_LAST_DIR/checks.json" "$rd/checks.json"
    elif [[ "$cid" == ofc-v1 ]]; then
      CHECKS_LAST_DIR=''
      CHECKS_LAST_SNAPSHOT="$snapshot"
      if [[ -n "$dirty_reason" ]]; then
        cmd_checks "$c" --allow-dirty "$dirty_reason"
      else
        cmd_checks "$c"
      fi
      local latest="$d/runs/.checks-latest.json"
      [[ -f "$latest" ]] || die "baseline-checks-failed: missing $latest"
      jq --argjson iter 0 --arg evaluator baseline-bootstrap \
        --arg check_dir "${CHECKS_LAST_DIR:-}" \
        '. + {iter:0, kind:"baseline", evaluator:$evaluator, analyst_stamp:null, check_evidence:(if $check_dir=="" then null else $check_dir end)}' \
        "$latest" > "$rd/scores.json"
      [[ -n "${CHECKS_LAST_DIR:-}" && -f "$CHECKS_LAST_DIR/checks.json" ]] && cp -f "$CHECKS_LAST_DIR/checks.json" "$rd/checks.json"
    else
      # Honest default: no deterministic runner declared — do not invent scores.
      jq -n --arg ts "$(date -u +%Y-%m-%d)" --arg client "$c" --arg contract "$cid" \
        --arg reason "no checks_runner in contract.json; baseline deferred (honest unscored)" \
        '{ts:$ts,iter:0,kind:"baseline",client:$client,contract:$contract,evaluator:"baseline-bootstrap",analyst_stamp:null,overall:null,deferred:true,reason:$reason,scores:{}}' \
        > "$rd/scores.json"
      printf '  %sHonest default:%s no checks_runner — wrote deferred unscored baseline\n' "$D" "$R"
    fi
  else
    die "baseline-provider-requires-analyst: scorer=provider — run: productteam role $c invoke Analyst 0 '<task>'; then productteam score $c --iter 0"
  fi

  jq -c '{ts, iter, kind, evaluator, analyst_stamp, overall, deferred}' "$rd/scores.json" >> "$d/history.jsonl"
  local ov; ov=$(jq -r '.overall // "deferred"' "$rd/scores.json")
  printf '  %sRecorded iter-0 baseline — overall %s%s\n' "$B" "$R" "$ov"
  printf '  %s%s%s\n\n' "$D" "$rd/scores.json" "$R"
}


cmd_gh() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    preflight) gh_preflight "${1:-$PWD}" ;;
    pr-create)
      local dir="${1:-$PWD}"
      local url
      url=$(gh_pr_create "$dir") || die 'pr-create failed'
      printf '\n  %sPR:%s %s\n\n' "$G" "$R" "$url"
      mkdir -p "$ROOT/state/harness-evolution/runs"
      printf '%s\n' "$url" > "$ROOT/state/harness-evolution/runs/.last-pr-url"
      ;;
    status)  gh_pr_status "${1:-$PWD}" "${2:-}" ;;
    checks)  gh_pr_checks "${1:-$PWD}" "${2:-}" ;;
    merge)
      gh_pr_merge "${1:-$PWD}" "${2:-}" || die 'merge refused or failed'
      ;;
    validate)
      local dir="${1:-$PWD}" ref="${2:-HEAD}" out="${3:-}"
      if [[ -z "$out" ]]; then
        out="$ROOT/state/harness-evolution/runs/.last-validate.txt"
      fi
      mkdir -p "$(dirname "$out")"
      gh_pr_validate "$dir" "$ref" "$out"
      printf '\n  %svalidation →%s %s\n\n' "$D" "$R" "$out"
      ;;
    *) die "usage: productteam gh preflight|pr-create|status|checks|merge|validate …" ;;
  esac
}

cmd_smoke() {
  bash "$ROOT/tests/consult-smoke.sh"
}

cmd_memory() {
  [[ -f "$ROOT/MEMORY.md" ]] || die 'MEMORY.md not found'
  printf '\n'; sed 's/^/  /' "$ROOT/MEMORY.md"; printf '\n'
}

cmd_bench() {
  local c="$1" d; d=$(client_dir "$c")
  local cid='v1' frozen='2026-08-05' target='9.0'
  if [[ -f "$d/contract.json" ]]; then
    cid=$(jq -r '.contract // "v1"' "$d/contract.json")
    frozen=$(jq -r '.frozen // "unknown"' "$d/contract.json")
    target=$(jq -r '.target // 9.0' "$d/contract.json")
  fi
  printf '\n  %sBenchmark — %s%s%s\n' "$B" "$c" "$R" "$D"
  printf '  Contract %s · frozen %s · target ≥ %s in every dimension%s\n\n' "$cid" "$frozen" "$target" "$R"

  # history
  if [[ -f "$d/history.jsonl" && -s "$d/history.jsonl" ]]; then
    printf '  %sHISTORY%s\n' "$B" "$R"
    printf '   %siter  date        kind        overall   areas≥9   weakest%s\n' "$D" "$R"
    local sparkvals=''
    while IFS= read -r line; do
      local iter kind ts ov at weak ws
      iter=$(jq -r '.iter' <<<"$line")
      kind=$(jq -r '.kind' <<<"$line")
      ts=$(jq -r '.ts' <<<"$line")
      ov=$(jq -r '.overall' <<<"$line")
      at=$(jq -r '[.scores | to_entries[] | select((.value|if type=="number" then . else .score end)>=9)] | length' <<<"$line")
      weak=$(jq -r '.scores | to_entries | min_by(.value|if type=="number" then . else .score end) | "\(.key) \(.value|if type=="number" then . else .score end)"' <<<"$line")
      printf '   %-5s %-11s %-11s %s%-8s%s %-9s %s\n' \
        "$iter" "$ts" "$kind" "$(score_color "$ov")" "$ov" "$R" "$at" "$weak"
      sparkvals+="$ov"$'\n'
    done < "$d/history.jsonl"
    printf '   %strend: %s%s\n\n' "$D" "$(spark <<<"$sparkvals")" "$R"
  else
    printf '  %sNo scored runs yet. First: productteam bench %s run%s\n\n' "$D" "$c" "$R"
  fi

  # latest detail
  local last; last=$(latest_run "$d")
  [[ -n "$last" && -f "$d/runs/$last/scores.json" ]] || return 0
  printf '  %sLATEST — %s%s\n' "$B" "$last" "$R"
  local prev=''
  if [[ -f "$d/history.jsonl" && -s "$d/history.jsonl" ]]; then
    prev=$(jq -rs --argjson n "${last#iter-}" '[.[] | select(.iter < $n)] | last | .iter // empty' "$d/history.jsonl" 2>/dev/null || true)
  fi
  local prev_scores='{}'
  if [[ -n "$prev" && -f "$d/runs/iter-$prev/scores.json" ]]; then
    prev_scores=$(jq -c '.scores' "$d/runs/iter-$prev/scores.json")
  fi
  jq -r '.scores | to_entries[] | "\(.key)\t\(.value|if type=="number" then . else .score end)\t\(.value|if type=="number" then "" elif (.evidence|type)=="array" then (.evidence|join("; ")) else (.evidence // "") end)"' \
    "$d/runs/$last/scores.json" | \
  while IFS=$'\t' read -r area sc ev; do
    local delta='' ev_path='' ev_text="$ev"
    if [[ "$ev" == *': '* && "${ev%%:*}" =~ [./] ]]; then
      ev_path="${ev%%:*}"
      ev_text="${ev#*: }"
    fi
    if [[ -n "$prev" && "$prev_scores" != '{}' ]]; then
      local psc
      psc=$(jq -r --arg a "$area" '.[$a] // empty' <<<"$prev_scores")
      if [[ -n "$psc" ]]; then
        local pv
        pv=$(score_val "$psc")
        delta=$(awk -v a="$sc" -v b="$pv" 'BEGIN{d=a-b; printf "%s%.1f", (d>=0?"+":""), d}')
      fi
    fi
    printf '   %-20s %s%4s%s %s  %s\n' "$area" "$(score_color "$sc")" "$sc" "$R" "$(bar "$sc")" "$(render_evidence "$delta" "$ev_path" "$ev_text")"
  done
  local ov; ov=$(jq -r '.overall' "$d/runs/$last/scores.json")
  printf '\n   %soverall%s  %s%s%s   %s%s/scores.json%s\n\n' "$B" "$R" "$(score_color "$ov")" "$ov" "$R" "$D" "$d/runs/$last" "$R"
}

cmd_run_detail() {
  local c="$1" n="$2" d; d=$(client_dir "$c")
  local rd="$d/runs/iter-$n"
  [[ -f "$rd/scores.json" ]] || die "no scores for $c iter-$n"
  printf '\n  %s%s — %s%s\n' "$B" "$c" "iter-$n" "$R"
  local prev=''
  if [[ -f "$d/history.jsonl" && -s "$d/history.jsonl" ]]; then
    prev=$(jq -rs --argjson n "$n" '[.[] | select(.iter < $n)] | last | .iter // empty' "$d/history.jsonl" 2>/dev/null || true)
  fi
  local prev_scores='{}'
  if [[ -n "$prev" && -f "$d/runs/iter-$prev/scores.json" ]]; then
    prev_scores=$(jq -c '.scores' "$d/runs/iter-$prev/scores.json")
  fi
  jq -r '.scores | to_entries[] | "\(.key)\t\(.value|if type=="number" then . else .score end)\t\(.value|if type=="number" then "" elif (.evidence|type)=="array" then (.evidence|join("; ")) else (.evidence // "") end)"' "$rd/scores.json" | \
  while IFS=$'\t' read -r area sc ev; do
    local delta='' ev_path='' ev_text="$ev"
    if [[ "$ev" == *': '* && "${ev%%:*}" =~ [./] ]]; then
      ev_path="${ev%%:*}"
      ev_text="${ev#*: }"
    fi
    if [[ -n "$prev" && "$prev_scores" != '{}' ]]; then
      local psc
      psc=$(jq -r --arg a "$area" '.[$a] // empty' <<<"$prev_scores")
      if [[ -n "$psc" ]]; then
        local pv
        pv=$(score_val "$psc")
        delta=$(awk -v a="$sc" -v b="$pv" 'BEGIN{d=a-b; printf "%s%.1f", (d>=0?"+":""), d}')
      fi
    fi
    printf '   %-20s %s%4s%s %s\n     %s\n' "$area" "$(score_color "$sc")" "$sc" "$R" "$(bar "$sc")" "$(render_evidence "$delta" "$ev_path" "$ev_text")"
  done
  printf '\n   %soverall%s %s%s\n' "$B" "$R" "$(score_color "$(jq -r .overall "$rd/scores.json")")" "$(jq -r .overall "$rd/scores.json")"
  [[ -f "$rd/report.md" ]] && printf '\n  %sreport:%s %s\n' "$D" "$R" "$rd/report.md"
  printf '\n'
}

cmd_report() {
  local c="$1" d; d=$(client_dir "$c")
  local last; last=$(latest_run "$d")
  [[ -n "$last" && -f "$d/runs/$last/report.md" ]] || die "no report yet for $c"
  printf '\n'
  render_markdown_lite "$d/runs/$last/report.md"
  printf '\n'
}

cmd_bench_run() {
  local c="$1"; shift
  local d; d=$(client_dir "$c")
  parse_score_args "$@"
  local n="$SCORE_ITER" refusal
  refusal=$(role_stamp_refusal "$d" "$n"); [[ -z "$refusal" ]] || die "$refusal"
  local scorer; scorer=$(engagement_scorer "$d")
  [[ "$scorer" == provider ]] || die "engagement '$c' uses scorer=$scorer — use: productteam score $c (or productteam checks $c)"
  [[ -f "$d/engagement.md" ]] || die "missing $d/engagement.md (brief with Repo: path)"
  local snapshot repo
  snapshot=$(workspace_ensure "$c" "$d" "$SCORE_DIRTY_REASON") || exit $?
  repo=$(jq -r '.path' <<<"$snapshot")
  local kind='iteration' rd="$d/runs/iter-$n"
  [[ -e "$rd/scores.json" ]] && die "scores already exist for role iter $n: $rd/scores.json"
  mkdir -p "$rd"
  workspace_write_evidence "$snapshot" "$rd/workspace.json" score
  printf '\n  %sScoring %s — role iter %s (%s)%s\n' "$B" "$c" "$n" "$kind" "$R"
  printf '  %sProvider: %s · repo: %s%s\n' "$D" "${CONSULT_PROVIDER:-$(runtime_default 2>/dev/null || echo none)}" "$repo" "$R"
  printf '  %sThe Analyst is inspecting the client…%s\n\n' "$D" "$R"

  local prompt reply
  prompt=$(cat <<EOF
You are the Analyst of a consulting organization scoring a client repo against a FROZEN benchmark contract. Score strictly and independently; cite file-path evidence for every score. Never inflate: 9-10 means excellent with evidence, 5-6 means works but real gaps, below 4 means broken/missing.

Client repo: $repo
Engagement brief: $d/engagement.md

Contract v1 — score each area 0-10 (one decimal):
1. correctness — claims/links/paths/code do what they say
2. simplicity — nothing removable without loss
3. maintainability — a stranger can change it safely
4. usability — first-time user succeeds cold
5. educational-quality — pedagogy sound, complete, consistent (learning product)
6. developer-experience — clone-to-value friction
7. architecture — structure matches purpose, no over-build
8. documentation — right docs, current, findable
9. product-clarity — what/for-whom/not-what visible within a minute

Read the brief and the repo (key files, structure, links, README, entry points). Then output ONLY a JSON object, no prose:
{"scores":{"correctness":{"score":0.0,"evidence":"path: why"},...one entry per area...}}
EOF
)
  reply=$(provider_ask "$prompt" "$repo") || die 'provider failed'

  # extract the first balanced JSON object from the reply; write scores.json
  if ! printf '%s' "$reply" | python3 -c '
import json, sys, datetime
out, iter_n, kind = sys.argv[1], int(sys.argv[2]), sys.argv[3]
raw = sys.stdin.read()
obj, i = None, raw.find("{")
while i != -1:
    try:
        obj, _ = json.JSONDecoder().raw_decode(raw[i:]); break
    except Exception:
        i = raw.find("{", i + 1)
if obj is None: sys.exit(1)
areas = ["correctness","simplicity","maintainability","usability","educational-quality","developer-experience","architecture","documentation","product-clarity"]
scores = {a: {"score": round(float(obj["scores"][a]["score"]), 1),
              "evidence": str(obj["scores"][a].get("evidence", "")).strip()[:300]} for a in areas}
overall = round(sum(s["score"] for s in scores.values()) / len(scores), 1)
evaluator, stamp = sys.argv[4], sys.argv[5]
json.dump({"ts": datetime.date.today().isoformat(), "iter": iter_n, "kind": kind,
           "evaluator": evaluator, "analyst_stamp": stamp,
           "scores": scores, "overall": overall}, open(out, "w"), indent=2)
' "$rd/scores.json" "$n" "$kind" "$(jq -r '.identity' "$(role_stamp_path "$d" "$n")")" "$(role_stamp_path "$d" "$n")"; then
    printf '%s\n' "$reply" > "$rd/raw-provider-output.txt"
    die "provider returned no parseable contract JSON (raw output kept in $rd/raw-provider-output.txt)"
  fi

  jq -c '{ts, iter, kind, evaluator, analyst_stamp, overall, scores}' "$rd/scores.json" >> "$d/history.jsonl"
  local ov; ov=$(jq -r '.overall' "$rd/scores.json")
  printf '  %sRecorded iter %s — overall %s%s\n' "$B" "$n" "$(score_color "$ov")" "$ov"
  printf '  %s%s%s\n\n' "$D" "$rd/scores.json" "$R"
}

# ── dispatch ─────────────────────────────────────────────────────────
main() {
  local cmd="${1:-status}"; shift || true
  [[ "$cmd" == "-h" || "$cmd" == "--help" ]] && { cmd_help; return; }
  case "$cmd" in
    help)           cmd_help ;;
    status)         cmd_status ;;
    chat)           cmd_chat ;;
    org)            cmd_org ;;
    memory)         cmd_memory ;;
    smoke)          cmd_smoke ;;
    agents)         cmd_agents "$@" ;;
    runtime)        cmd_agents "$@" ;;
    splash)         cmd_splash "$@" ;;
    onboarding)     cmd_onboarding "$@" ;;
    harness-checks)
      cmd_harness_checks "${1:-}" ;;
    gh)
      [[ $# -ge 1 ]] || die 'usage: productteam gh preflight|pr-create|status|checks|merge|validate …'
      cmd_gh "$@" ;;
    skill)
      [[ $# -ge 2 ]] || die 'usage: productteam skill <critique|benchmark|design-sprint> <target> [out-dir]'
      cmd_skill "$@" ;;
    judge)
      [[ $# -ge 1 ]] || die 'usage: productteam judge <client> [set <mode>]'
      if [[ "${2:-}" == 'set' ]]; then
        [[ $# -ge 3 ]] || die 'usage: productteam judge <client> set <mode>'
        cmd_judge_set "$1" "$3"
      else
        cmd_judge "$1"
      fi ;;
    open)
      cmd_open "$@" ;;
    baseline)
      [[ $# -ge 1 ]] || die 'usage: productteam baseline <client> [--allow-dirty <reason>]'
      cmd_baseline "$@" ;;
    workspace|worktree)
      [[ $# -ge 2 ]] || die 'usage: productteam workspace <client> ensure|status|remove'
      cmd_workspace "$@" ;;
    gate)
      [[ $# -ge 2 ]] || die 'usage: productteam gate <client> status|implement|select|direct|challenge|override …'
      cmd_gate "$@" ;;
    escalation)
      [[ $# -ge 2 ]] || die 'usage: productteam escalation <client> block|status|resume …'
      cmd_escalation "$@" ;;
    inspect)
      [[ $# -ge 1 ]] || die 'usage: productteam inspect <client> [out]'
      cmd_inspect "$@" ;;
    role)
      [[ $# -ge 2 ]] || die 'usage: productteam role <client> seal|invoke|status|close …'
      cmd_role "$@" ;;
    score)
      [[ $# -ge 1 ]] || die 'usage: productteam score <client> --iter <n>'
      cmd_score "$@" ;;
    checks)
      [[ $# -ge 1 ]] || die 'usage: productteam checks <client> [--allow-dirty <reason>]'
      cmd_checks "$@" ;;
    bench)
      [[ $# -ge 1 ]] || die 'usage: productteam bench <client> [run --iter <n>]'
      if [[ "${2:-}" == 'run' ]]; then cmd_bench_run "$1" "${@:3}"; else cmd_bench "$1"; fi ;;
    run)
      [[ $# -ge 2 ]] || die 'usage: productteam run <client> <iter>'
      cmd_run_detail "$1" "$2" ;;
    report)
      [[ $# -ge 1 ]] || die 'usage: productteam report <client>'
      cmd_report "$1" ;;
    *) die "unknown command '$cmd' — cause: not in the command table. Remedy: productteam help" ;;
  esac
}
main "$@"
